<?xml version="1.0"?>
<ruleset name="Fluxie"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Complexidade e tamanho de código: limites padrão do PHPMD, os mesmos usados pelo mercado.</description>

    <!-- Complexidade -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity"/>
    <rule ref="rulesets/codesize.xml/NPathComplexity"/>
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity"/>

    <!-- Tamanho de método, classe e assinatura -->
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength"/>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength"/>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList"/>
    <rule ref="rulesets/codesize.xml/ExcessivePublicCount"/>
    <rule ref="rulesets/codesize.xml/TooManyFields"/>
    <rule ref="rulesets/codesize.xml/TooManyMethods"/>

    <!-- O padrão é 10. WahaClient é um cliente de API com um método por endpoint do WAHA. -->
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maximum" value="15"/>
        </properties>
    </rule>

    <!-- Acoplamento: limite padrão 13; as classes acima dele estão em phpmd.baseline.xml até serem reduzidas. -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects"/>

    <!-- Código morto -->
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- Código limpo -->
    <rule ref="rulesets/cleancode.xml">
        <!-- Facades do Laravel (Auth::, Cache::, DB::) são acesso estático por desenho: 794 avisos sem valor. -->
        <exclude name="StaticAccess"/>
        <!-- Flags booleanas em parâmetros (ex.: $force = false) são idioma comum e legível aqui: 28 avisos. -->
        <exclude name="BooleanArgumentFlag"/>
    </rule>

    <!-- naming.xml fica de fora de propósito: 238 dos 241 avisos são ShortVariable ($q, $e, $t),
         nomes curtos idiomáticos de closures de query e catch. -->
</ruleset>
