includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/Architecture/

    tmpDir: .phpstan.cache
    level: max

services:
    -
        class: Tests\Architecture\LayerRules
        tags:
            - phpat.test
